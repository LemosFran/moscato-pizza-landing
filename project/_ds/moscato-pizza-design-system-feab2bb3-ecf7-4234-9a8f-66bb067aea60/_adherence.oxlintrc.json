{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/feedback/**",
              "components/navigation/**",
              "ui_kits/marketing-site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Salo Uberto|Awesome Serif|Azeret Mono|Caveat))/i]",
        "message": "Font not provided by the design system. Available: Salo Uberto, Awesome Serif, Azeret Mono, Caveat."
      },
      {
        "selector": "JSXOpeningElement[name.name='StarRating'] > JSXAttribute > JSXIdentifier[name!=/^(?:score|max|showScore|key|ref|className|style|children)$/]",
        "message": "<StarRating> doesn't accept that prop. Declared props: score, max, showScore."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|shape|size|icon|disabled|onClick|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, shape, size, icon, disabled, onClick, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|navy|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'navy' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:scoop|notch|scoop-filled|scoop-outline)$/]",
        "message": "<Button> shape must be one of 'scoop' | 'notch' | 'scoop-filled' | 'scoop-outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CheckerBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|color|height|offset|key|ref|className|style|children)$/]",
        "message": "<CheckerBar> doesn't accept that prop. Declared props: size, color, height, offset."
      },
      {
        "selector": "JSXOpeningElement[name.name='CheckerBar'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:small|large)$/]",
        "message": "<CheckerBar> size must be one of 'small' | 'large'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CheckerBar'] > JSXAttribute[name.name='offset'] > Literal[value!=/^(?:even|odd)$/]",
        "message": "<CheckerBar> offset must be one of 'even' | 'odd'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CurvedText'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|curve|width|color|fontSize|key|ref|className|style|children)$/]",
        "message": "<CurvedText> doesn't accept that prop. Declared props: text, curve, width, color, fontSize."
      },
      {
        "selector": "JSXOpeningElement[name.name='LetterCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|paragraphs|children|photo|photoAlt|photoLabel|photoRatio|photoPosition|signature|signatureSrc|tone|width|shadow|style|key|ref|className|style|children)$/]",
        "message": "<LetterCard> doesn't accept that prop. Declared props: title, paragraphs, children, photo, photoAlt, photoLabel, photoRatio, photoPosition, signature, signatureSrc, tone, width, shadow, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LetterCard'] > JSXAttribute[name.name='photoPosition'] > Literal[value!=/^(?:top|bottom)$/]",
        "message": "<LetterCard> photoPosition must be one of 'top' | 'bottom'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LetterCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:cream|blue|navy)$/]",
        "message": "<LetterCard> tone must be one of 'cream' | 'blue' | 'navy'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LocationPlaque'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|score|max|title|stats|dots|strip|background|key|ref|className|style|children)$/]",
        "message": "<LocationPlaque> doesn't accept that prop. Declared props: eyebrow, score, max, title, stats, dots, strip, background."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:brand|links|cta|onCtaClick|key|ref|className|style|children)$/]",
        "message": "<NavBar> doesn't accept that prop. Declared props: brand, links, cta, onCtaClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='PolaroidPhoto'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|label|caption|rotate|width|tone|shadow|key|ref|className|style|children)$/]",
        "message": "<PolaroidPhoto> doesn't accept that prop. Declared props: src, alt, label, caption, rotate, width, tone, shadow."
      },
      {
        "selector": "JSXOpeningElement[name.name='PolaroidPhoto'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:sky|mustard|cream|navy)$/]",
        "message": "<PolaroidPhoto> tone must be one of 'sky' | 'mustard' | 'cream' | 'navy'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PostcardPlaque'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|footnote|key|ref|className|style|children)$/]",
        "message": "<PostcardPlaque> doesn't accept that prop. Declared props: eyebrow, title, footnote."
      },
      {
        "selector": "JSXOpeningElement[name.name='Ribbon'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|rotate|children|key|ref|className|style|children)$/]",
        "message": "<Ribbon> doesn't accept that prop. Declared props: tone, rotate, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Ribbon'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:sky|mustard|cream|navy)$/]",
        "message": "<Ribbon> tone must be one of 'sky' | 'mustard' | 'cream' | 'navy'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScoopCardChecklistItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|key|ref|className|style|children)$/]",
        "message": "<ScoopCardChecklistItem> doesn't accept that prop. Declared props: title, description."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpecStat'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SpecStat> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='StampBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:shape|tone|value|label|size|key|ref|className|style|children)$/]",
        "message": "<StampBadge> doesn't accept that prop. Declared props: shape, tone, value, label, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='StampBadge'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:circle|diamond|octagon|bloom|gem|plaque)$/]",
        "message": "<StampBadge> shape must be one of 'circle' | 'diamond' | 'octagon' | 'bloom' | 'gem' | 'plaque'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StampBadge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:navy|brown|mustard)$/]",
        "message": "<StampBadge> tone must be one of 'navy' | 'brown' | 'mustard'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TestimonialCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:quote|author|org|score|key|ref|className|style|children)$/]",
        "message": "<TestimonialCard> doesn't accept that prop. Declared props: quote, author, org, score."
      },
      {
        "selector": "JSXOpeningElement[name.name='TicketCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|children|eyebrow|photo|photoAlt|photoLabel|photoRatio|ctaLabel|onCtaClick|ctaHref|tone|width|align|style|key|ref|className|style|children)$/]",
        "message": "<TicketCard> doesn't accept that prop. Declared props: text, children, eyebrow, photo, photoAlt, photoLabel, photoRatio, ctaLabel, onCtaClick, ctaHref, tone, width, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TicketCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:sky|cream|mustard|navy)$/]",
        "message": "<TicketCard> tone must be one of 'sky' | 'cream' | 'mustard' | 'navy'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TicketCard'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<TicketCard> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TicketPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|text|children|photo|photoAlt|photoLabel|photoRatio|tone|width|align|style|key|ref|className|style|children)$/]",
        "message": "<TicketPanel> doesn't accept that prop. Declared props: eyebrow, title, text, children, photo, photoAlt, photoLabel, photoRatio, tone, width, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TicketPanel'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:sky|cream|mustard|navy)$/]",
        "message": "<TicketPanel> tone must be one of 'sky' | 'cream' | 'mustard' | 'navy'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TicketPanel'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<TicketPanel> align must be one of 'left' | 'center'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
